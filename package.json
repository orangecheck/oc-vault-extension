{
    "name": "oc-vault-extension",
    "version": "0.1.1",
    "private": true,
    "description": "Browser extension companion to vault.ochk.io — unlock once, fill anywhere, trust the origin.",
    "license": "MIT",
    "author": "OrangeCheck",
    "homepage": "https://ochk.io/docs/vault/extension",
    "repository": {
        "type": "git",
        "url": "https://github.com/orangecheck/oc-vault-extension"
    },
    "bugs": {
        "url": "https://github.com/orangecheck/oc-vault-extension/issues"
    },
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox",
        "build": "wxt build",
        "build:firefox": "wxt build -b firefox",
        "zip": "wxt zip",
        "compile": "tsc --noEmit",
        "postinstall": "wxt prepare",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "node --test 'lib/**/*.test.mjs'"
    },
    "dependencies": {
        "@noble/hashes": "^1.5.0",
        "@orangecheck/lock-crypto": "^0.1.0",
        "@orangecheck/vault-core": "0.4.0",
        "lucide-react": "^0.544.0",
        "next-themes": "^0.4.6",
        "react": "19.1.0",
        "react-dom": "19.1.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.4",
        "@types/chrome": "^0.0.287",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@wxt-dev/module-react": "^1.1.3",
        "prettier": "3.8.3",
        "tailwindcss": "^4.3.4",
        "typescript": "^5",
        "wxt": "^0.20.0"
    },
    "overrides": {
        "shell-quote": "^1.12.0"
    }
}
